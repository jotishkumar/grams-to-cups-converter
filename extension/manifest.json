{
  "manifest_version": 3,
  "name": "GramsInCup – Grams to Cups Converter",
  "short_name": "GramsInCup",
  "version": "1.0.0",
  "description": "Convert grams to cups, tablespoons, teaspoons and ounces for 48 baking ingredients, right from your toolbar.",
  "homepage_url": "https://gramsincup.com/",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Grams to Cups Converter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "converter@gramsincup.com",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}